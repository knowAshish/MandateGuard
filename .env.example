# MandateGuard Environment Configuration
# Copy this file to .env and configure for your Canton DevNet participant deployment.
# NEVER commit real private keys, API tokens, or secrets to source control.

# Application Server
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Canton Participant Node (DevNet)
# The HTTP JSON Ledger API v2 base URL exposed by your Canton participant node.
CANTON_LEDGER_BASE_URL=https://participant.devnet.canton.network
CANTON_LEDGER_TIMEOUT_MS=30000

# Canton Authentication (JWT)
# If your participant requires an OAuth2 / JWT bearer token, provide it here.
CANTON_LEDGER_TOKEN=

# Participant Ledger Identification
CANTON_LEDGER_ID=canton-devnet-01

# Authorized Canton Parties (Server-side resolved parties)
OPERATOR_PARTY=Operator::1220a1b2c3d4...
INSTITUTION_PARTY=InstitutionalTreasury::1220e5f6g7h8...

# Postgres Projections & Idempotency Store
DATABASE_URL=postgresql://mandateguard:password@localhost:5432/mandateguard_projections

# Security & Session
SESSION_SECRET=replace-with-cryptographically-secure-random-secret
CORS_ORIGIN=http://localhost:5173
