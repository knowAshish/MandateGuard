{
  "name": "mandateguard",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional Digital-Asset Mandate Firewall & Transaction Authorization Control Plane",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "codegen": "dpm codegen-js -o packages/daml-ledger daml/main/.daml/dist/mandateguard-0.1.0.dar",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
